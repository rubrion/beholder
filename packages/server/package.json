{
  "name": "@rubrion/agent-kit-server",
  "version": "0.0.0-semantic-release",
  "description": "Agent worker (Mastra on Cloudflare Workers, D1 memory, slim SSE) and the gateway that fronts it.",
  "license": "MIT",
  "author": "Rubrion",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rubrion/agent-kit.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/rubrion/agent-kit#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./gateway": {
      "types": "./dist/gateway-entry.d.ts",
      "import": "./dist/gateway-entry.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@rubrion/mastra-cloudflare": "^0.6.0",
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
