{
  "name": "@rubrion/beholder-react",
  "version": "0.0.0-semantic-release",
  "description": "Beholder's React chat UI, an agent kit for Cloudflare apps: floating chat box, full assistant screen, streamed steps (thinking, tool calls, text).",
  "keywords": [
    "agent-kit",
    "ai-agent",
    "assistant",
    "cloudflare-workers",
    "mastra",
    "chat",
    "beholder",
    "react"
  ],
  "license": "MIT",
  "author": "Rubrion",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rubrion/beholder.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/rubrion/beholder#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && cp src/styles.css dist/styles.css",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "marked": "^18.1.2"
  },
  "peerDependencies": {
    "lucide-react": ">=0.400.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "lucide-react": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
